{
  "name": "create-garmin-coach",
  "version": "0.1.0",
  "description": "Create a local, privacy-safe GarminCoach workspace.",
  "type": "module",
  "bin": {
    "create-garmin-coach": "bin/create-garmin-coach.mjs"
  },
  "files": [
    "README.md",
    "GUIDE.md",
    "package.json",
    "bin/",
    "sync.py",
    "setup_status.py",
    "garmin_workouts.py",
    "collect_feedback.py",
    "release_audit.py",
    "garmin_coach/*.py",
    ".env.example",
    "athlete_config.example.py",
    "requirements.txt",
    "requirements-feedback.txt",
    "skills/",
    "templates/",
    "examples/",
    "tests/*.py",
    "tests/*.mjs",
    "LICENSE"
  ],
  "garminCoach": {
    "scaffoldExclude": [
      "bin/",
      "templates/"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "audit:public": "python release_audit.py"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
