# Copy this file to .env (same directory) and fill in your real values.
# .env is already in .gitignore — never committed to git.

# Garmin Connect login. Only used the first time, or if the saved tokens
# expire; afterwards sync.py reuses the tokens in GARMIN_TOKEN_DIR.
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-password

# Where your activities CSV and the history the skill reads live. Use
# absolute paths. activity_laps.csv is derived automatically (same folder as CSV_PATH).
CSV_PATH=/path/to/your/activities.csv
GARMIN_TOKEN_DIR=/path/to/your/garmin_tokens
TRAINING_HISTORY_PATH=/path/to/your/skill/references/training-history.md

# Optional: only needed if you use collect_feedback.py (voice-note feedback
# via Telegram Saved Messages + faster-whisper). Get these from https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional: faster-whisper model for collect_feedback.py (default: medium).
# WHISPER_MODEL=medium

# Optional: context vocabulary to improve transcription accuracy (running
# jargon, injuries you're carrying, session names). If left empty,
# collect_feedback.py uses a generic default. Example (put your own here):
# WHISPER_PROMPT=Entrenamiento de running. Ritmo, pace, series, tempo, umbral, fascitis plantar, tendon de Aquiles.
