# Copia este archivo a .env (mismo directorio) y completa tus valores reales.
# .env ya esta en .gitignore — nunca se sube a git.

# Login de Garmin Connect. Se usa solo la primera vez o si los tokens guardados
# vencen; despues sync.py reusa los tokens en GARMIN_TOKEN_DIR.
GARMIN_EMAIL=tu-email@ejemplo.com
GARMIN_PASSWORD=tu-password

# Donde vive tu CSV de actividades y el historial que lee la skill. Usa paths
# absolutos. activity_laps.csv se deriva automaticamente (misma carpeta que CSV_PATH).
CSV_PATH=/ruta/a/tu/activities.csv
GARMIN_TOKEN_DIR=/ruta/a/tu/garmin_tokens
TRAINING_HISTORY_PATH=/ruta/a/tu/skill/references/training-history.md

# Opcional: si usas Strava para trackear kilometraje de zapatillas (fetch_activity_laps
# / gear mileage). Dejalo vacio si no lo usas.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=

# Opcional: solo si usas collect_feedback.py (feedback por audio via Telegram
# Mensajes Guardados + faster-whisper). Sacalos de https://my.telegram.org.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Opcional: modelo de faster-whisper para collect_feedback.py (default: medium).
# WHISPER_MODEL=medium
