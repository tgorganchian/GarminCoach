# Copy to .env during guided setup. It is ignored by Git.
# Enter credentials yourself; never paste them into an agent conversation.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Relative, workspace-local paths.
CSV_PATH=data/activities.csv
GARMIN_TOKEN_DIR=garmin_tokens

# Optional alternate journal root (for example, a local Obsidian folder).
JOURNAL_PATH=coaching/journal

# Optional voice feedback. Leave blank unless configured.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
WHISPER_MODEL=
WHISPER_LANGUAGE=
WHISPER_PROMPT=
